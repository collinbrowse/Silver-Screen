// The only copy of the shipping version. The app target must not set
// MARKETING_VERSION or CURRENT_PROJECT_VERSION itself, or Xcode will ignore
// this file. Change the numbers with scripts/release.py.

// User-facing version. Three integers. Apple rejects suffixes and a fourth component.
MARKETING_VERSION = 0.1.1
// Upload counter. `cut` adds one; the number never goes down, including across
// marketing versions. Dev runs do not consume a build.
CURRENT_PROJECT_VERSION = 3