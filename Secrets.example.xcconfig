# Copy this file to Secrets.xcconfig and fill in your values.
# Secrets.xcconfig is gitignored — never commit real values.
#
# TMDB_ACCESS_TOKEN is the API Read Access Token from
# https://www.themoviedb.org/settings/api (it starts with eyJ).
# The 32-character v3 API key will not work.

TMDB_ACCESS_TOKEN =

# Optional: call the Silver Screen TMDB proxy (worker/README.md) instead of TMDB.
# The proxy adds the token, so a build that sets this needs no TMDB_ACCESS_TOKEN
# and should leave it empty. Keep the /3, and write // as /$()/:
#   TMDB_BASE_URL = https:/$()/silverscreen-tmdb.YOUR_SUBDOMAIN.workers.dev/3

# xcconfig treats // as a comment. Break the URL with $() so https:// survives:
#   SENTRY_DSN = https:/$()/PUBLIC_KEY@oXXXX.ingest.us.sentry.io/PROJECT_ID
SENTRY_DSN =
