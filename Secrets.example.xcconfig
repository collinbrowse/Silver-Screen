# Copy this file to Secrets.xcconfig and fill in your values.
# Secrets.xcconfig is gitignored — never commit real values.
#
# TMDB: nothing to set. Config.xcconfig points at the Silver Screen proxy
# (worker/README.md), which adds the token. To call TMDB directly instead, set both
# (the API Read Access Token starts with eyJ; the v3 API key will not work):
#   TMDB_BASE_URL = https:/$()/api.themoviedb.org/3
#   TMDB_ACCESS_TOKEN = eyJ...

# xcconfig treats // as a comment. Break the URL with $() so https:// survives:
#   SENTRY_DSN = https:/$()/PUBLIC_KEY@oXXXX.ingest.us.sentry.io/PROJECT_ID
SENTRY_DSN =

# Optional: anonymous product events (OBSERVABILITY.md → Product analytics).
# The App ID from TelemetryDeck → your app → Settings, a UUID. Empty sends nothing.
# Debug builds send in TelemetryDeck's test mode.
TELEMETRYDECK_APP_ID =
