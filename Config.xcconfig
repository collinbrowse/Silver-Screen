// Shared build settings. Secrets.xcconfig is optional so a fresh clone
// without a key still opens the project; the app fails clearly at launch.
// Version.xcconfig is required: it is the only shipping version.
#include? "Secrets.xcconfig"
#include "Version.xcconfig"

TMDBAccessToken = $(TMDB_ACCESS_TOKEN)
SentryDSN = $(SENTRY_DSN)
