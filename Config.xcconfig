// Shared build settings. Secrets.xcconfig is optional so a fresh clone
// without a key still opens the project; the app fails clearly at launch.
// Version.xcconfig is required: it is the only shipping version.

// The TMDB proxy in worker/ by default, so a fresh clone or worktree loads TMDB
// with no Secrets.xcconfig and no TMDB_ACCESS_TOKEN. The URL is not a secret: it
// ships in the app. Set before the include so Secrets.xcconfig can still point at
// api.themoviedb.org/3 with a token. xcconfig treats // as a comment.
TMDB_BASE_URL = https:/$()/silverscreen-tmdb.cbrowse13.workers.dev/3

#include? "Secrets.xcconfig"
#include "Version.xcconfig"

TMDBAccessToken = $(TMDB_ACCESS_TOKEN)
TMDBBaseURL = $(TMDB_BASE_URL)
SentryDSN = $(SENTRY_DSN)
TelemetryDeckAppID = $(TELEMETRYDECK_APP_ID)

// iPhone Duo fold APIs (ReservedRegion, onHingeChange) arrive in the iOS 27.1 SDK.
// FOLD_SDK gates that code at compile time so older Xcodes (CI runs Xcode 26) still
// build; `#available(iOS 27.1, *)` gates it at run time. Clear it for any SDK
// before 27.1.
FOLD_SDK_CONDITION = FOLD_SDK
FOLD_SDK_CONDITION[sdk=iphonesimulator26*] =
FOLD_SDK_CONDITION[sdk=iphoneos26*] =
FOLD_SDK_CONDITION[sdk=iphonesimulator27.0*] =
FOLD_SDK_CONDITION[sdk=iphoneos27.0*] =
FOLD_SDK_CONDITION[sdk=macosx*] =
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) $(FOLD_SDK_CONDITION)
