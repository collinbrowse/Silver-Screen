    "Films are matched to TMDB by title and year. Nothing already in your library is changed, so importing again is safe.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Filme werden über Titel und Jahr bei TMDB zugeordnet. In deiner Mediathek wird nichts geändert, ein erneuter Import ist also unbedenklich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las películas se buscan en TMDB por título y año. No se cambia nada de tu biblioteca, así que puedes volver a importar sin problema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les films sont associés à TMDB par titre et année. Rien de votre bibliothèque n’est modifié : vous pouvez réimporter sans risque."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os filmes são encontrados no TMDB pelo título e ano. Nada na sua biblioteca é alterado, então importar de novo é seguro."
          }
        }
      }
    },
